# devfmt has no Kotlin formatter of its own; ktfmt covers the .kt and .kts
# files. Gradle's wrapper is generated by Gradle and left as it is.
_: {
  perSystem.treefmt = {
    programs.ktfmt.enable = true;
    settings.global.excludes = [
      "gradlew"
      "gradlew.bat"
      "gradle/wrapper/*"
      "*.properties"
    ];
  };
}
